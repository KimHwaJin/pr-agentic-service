# local | dev | stg | prd
ENV=local
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/agentic
REDIS_URL=redis://localhost:6379/0
REDIS_NAMESPACE=agentic
# Run modes: all (default) | api | worker
RUN_MODE=all

# SSO: dev (local only) | company (SSO_ADAPTER_FACTORY=module:function returning SDK, e.g. lambda r, _: SSO(r))
SSO_ADAPTER=dev
SSO_ADAPTER_FACTORY=
PUBLIC_API_ORIGIN=http://localhost:8080
FRONTEND_ORIGIN=http://localhost:8080
SSO_ALLOWED_ORIGINS=[]
SESSION_COOKIE_NAME=agentic_session
COOKIE_SECURE=false
ADMIN_EMPLOYEE_IDS=[]
CORS_ORIGINS=[]

# LLM gateway (OpenAI compatible / vLLM). LLM_MODELS maps alias -> served model name.
# e.g. LLM_BASE_URL=http://model.frodo.com/v1, LLM_MODELS={"default": "qwen38-27b-fp8"}
LLM_BASE_URL=http://localhost:8001/v1
LLM_API_KEY=EMPTY
LLM_MODELS={"default": "default"}
LLM_DEFAULT_ALIAS=default
LLM_ENABLE_THINKING=false
AGENT_MODEL_CALL_LIMIT=40
# none (keyword search) | openai (gateway) | mock (local, hashed n-grams)
EMBEDDING_PROVIDER=none
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMS=1024

# Executor (paths are this pod's mounts of the executor INPUT/SHARED storage roots)
EXECUTOR_BASE_URL=http://localhost:8000
EXECUTOR_INPUT_ROOT=/mnt/data/agent
EXECUTOR_RESULT_ROOT=/mnt/data/executor
EXECUTOR_RUNTIME_PROFILE=default
EXECUTOR_OPERATION_WAIT_SECONDS=1800

# JupyterLab link for notebooks/reports: {base}/lab/workspaces/{prefix}{employee_id}/tree/{prefix path}/{artifact path}
NOTEBOOK_LAB_BASE_URL=
NOTEBOOK_LAB_PATH_PREFIX=
NOTEBOOK_LAB_WORKSPACE_PREFIX=agentic-

# Agent
DEFAULT_CODE_LEVEL=3
PLAN_CANDIDATES=5
RUN_CONCURRENCY=8

# pr-batch
BATCH_BASE_URL=http://localhost:8100
BATCH_JWT_SECRET=
BATCH_REPORT_JWT_SECRET=
