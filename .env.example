# Settings live in config.yml (local) and config.{APP_ENV}.yml (dev/stg/prd)
# at the repo root. This file is only for overriding a few values when running
# uvicorn on the host instead of compose (environment variables and .env win
# over the YAML files). Any Settings field can be overridden by its upper-case
# name. Leave APP_ENV unset locally.
# APP_ENV=dev
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/agentic
REDIS_URL=redis://localhost:6379/0
EXECUTOR_BASE_URL=http://localhost:8000
# host paths of the executor shared dir (compose mounts it at /mnt/executor-shared)
STORAGE_ROOT=/path/to/executor/shared_dir/agentic
EXECUTOR_RESULT_ROOT=/path/to/executor/shared_dir
