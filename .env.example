# Settings: config.yml (shared by every environment) and, in deployments,
# config.{APP_ENV}.yml on top (APP_ENV=dev|stg|prd). Locally APP_ENV stays
# empty and the local values come from docker-compose.yml's environment, or
# from this .env when running uvicorn on the host. Precedence: environment >
# .env > config.{APP_ENV}.yml > config.yml. Any Settings field can be set by
# its upper-case name; lists are JSON.
# APP_ENV=dev
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/agentic
REDIS_URL=redis://localhost:6379/0
SSO_ADAPTER=dev
PUBLIC_API_ORIGIN=http://localhost:8080
FRONTEND_ORIGIN=http://localhost:8080
SSO_ALLOWED_RETURN_ROOTS=["/", "/dev"]
COOKIE_SECURE=false
LLM_API_KEY=EMPTY
EMBEDDING_PROVIDER=mock
EXECUTOR_BASE_URL=http://localhost:8000
# host paths of the executor shared dir (compose mounts it at /mnt/executor-shared)
STORAGE_ROOT=/path/to/executor/shared_dir/dtest-agent-service
STORAGE_EXECUTOR_PATH=dtest-agent-service
EXECUTOR_RESULT_ROOT=/path/to/executor/shared_dir
EXECUTOR_TENANT_ID=dtest-agent-service
NOTEBOOK_LAB_BASE_URL=http://localhost:8888
BATCH_BASE_URL=http://localhost:8100
# Our keys at the executor and pr-batch: key mode only, locally too
# (the executor compose's local keys: ../executor/docker-compose.yml)
EXECUTOR_API_KEY=exe_local_agent_0123456789abcdef0123456789ab
EXECUTOR_ADMIN_API_KEY=exe_local_ops_0123456789abcdef0123456789abcd
BATCH_API_KEY=<pr-batch local key>
MODELS=[{"name": "qwen38-27b-nvfp4", "label": "Qwen 3.8 27B", "default": true, "input": ["text", "image"], "max_images": 8}]

# Phoenix tracing (optional, docs/phoenix-tracing.md); empty endpoint = off
# PHOENIX_ENDPOINT=http://phoenix.frodo.com
# PHOENIX_API_KEY=<Phoenix API key>
# SERVICE_ID=pr-agentic-service-local
