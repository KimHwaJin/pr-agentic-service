# Local run without the executor PV: this service on your machine, the
# executor (and its Jupyter) remote on Kubernetes. EXECUTOR_IO_MODE=api is a
# test mode (src/core/executor/testmode); delete this file when it is removed.
#   cp .env.testmode.example .env   then fill the <...> values.
# APP_ENV stays empty: config.yml supplies every other key, these override it
# (environment > .env > config.yml). Lists are JSON. Never commit .env.

# --- DB / Redis ---
# 서비스 DB (pgvector 필요). 계정과 비밀번호는 직접 채움
DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/agentic
# 서비스 Redis. executor가 이벤트를 쓰는 Redis여야 실행 완료가 바로 전달됨
REDIS_URL=redis://<executor-redis-host>:6379/0

# --- 주소 / 로그인 ---
# 브라우저가 여는 API, 프론트 주소 (로컬 uvicorn 포트)
PUBLIC_API_ORIGIN=http://localhost:8080
FRONTEND_ORIGIN=http://localhost:8080
# 다른 출처에서 부를 때만 채움
CORS_ORIGINS=[]
# http 로컬이므로 false
COOKIE_SECURE=false
# dev 로그인: 고정 사번으로 로그인 (env=local에서만 허용)
SSO_ADAPTER=dev
# dev 로그인 사용자의 사번과 이름
DEV_EMPLOYEE_ID=dev0001
DEV_EMPLOYEE_NAME=개발자
# 로그인 뒤 돌아갈 수 있는 경로 (/dev 테스트 콘솔 포함)
SSO_ALLOWED_RETURN_ROOTS=["/", "/dev"]
# 관리자 역할을 줄 사번 (실행 진단, 런타임 메뉴)
ADMIN_EMPLOYEE_IDS=["dev0001"]

# --- LLM / 임베딩 ---
# OpenAI 호환 게이트웨이 주소
LLM_BASE_URL=http://model.frodo.com/v1
# 게이트웨이 키 (자리표시자만, 실제 값은 .env에만)
LLM_API_KEY=<llm-api-key>
# 제공할 채팅 모델 (name = 게이트웨이의 모델 이름, 하나만 default: true)
MODELS=[{"name": "<model-name>", "label": "<표시 이름>", "default": true, "input": ["text"]}]
# 임베딩 서버 없이 워크플로우 검색을 돌리는 mock
EMBEDDING_PROVIDER=mock

# --- executor (PV 없음, 테스트 모드) ---
# PV 없이 코드는 INLINE으로 보내고 결과는 노트북 API로 읽음
EXECUTOR_IO_MODE=api
# 원격 executor 주소 (/api/v1 앞까지)
EXECUTOR_BASE_URL=http://<executor-host>:8000
# 이벤트 스트림 이름 (executor.events.<tenant>). 공용 executor에서 다른 실행과 섞이지 않게 바꿀 수 있음
EXECUTOR_TENANT_ID=pr-agentic
# executor에서 받은 우리 key (X-Api-Key, executor가 header 모드면 비워도 됨)
EXECUTOR_API_KEY=
# 코드 파일 사본을 둘 로컬 폴더 (상대 경로는 레포 루트 기준, executor는 이 폴더를 보지 않음)
STORAGE_ROOT=.local/shared/agentic
# executor에 보내는 경로 접두어 (api 모드에서는 값과 무관하게 동작)
STORAGE_EXECUTOR_PATH=pr-agentic-service
# 결과 볼륨 마운트 위치 (api 모드에서는 읽지 않음, 존재하지 않아도 됨)
EXECUTOR_RESULT_ROOT=.local/shared
# executor Redis에 붙지 못하면 완료 이벤트가 오지 않아, 이 시간(초)마다 executor API로 복구 조회함 (그만큼 지연)
EXECUTOR_EVENT_RECOVERY_SECONDS=10
# 채팅 결과의 이미지는 api 모드에서 보이지 않음 (이미지 파일이 결과 볼륨에만 있음)

# --- JupyterLab 링크 ---
# 원격 executor Jupyter 주소 (비우면 'JupyterLab에서 열기' 링크 없음)
NOTEBOOK_LAB_BASE_URL=https://<executor-jupyter-host>
# Jupyter 루트와 executor 공유 루트가 다를 때 그 사이 경로
NOTEBOOK_LAB_PATH_PREFIX=
# 사용자별 Jupyter 워크스페이스 이름 접두어
NOTEBOOK_LAB_WORKSPACE_PREFIX=agentic-

# --- pr-batch (선택) ---
# pr-batch 주소
BATCH_BASE_URL=http://<pr-batch-host>:8100
# pr-batch에서 받은 우리 key (X-Api-Key, pr-batch가 header 모드면 비워도 됨)
BATCH_API_KEY=
