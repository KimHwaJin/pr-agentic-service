<diagram id="p1" name="사용 흐름">
<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="640" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="p1-title" value="&lt;b&gt;사용자 메뉴얼: 분석 한 건의 흐름&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="900" height="30" as="geometry"/></mxCell>
<mxCell id="p1-login" value='&lt;b&gt;로그인&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;사내 SSO&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="p1-proj" value='&lt;b&gt;프로젝트 선택&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;없으면 새 프로젝트&lt;br&gt;(지침, 기본 코드 레벨)&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="90" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="p1-new" value='&lt;b&gt;새 대화&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;모델, 코드 레벨 선택&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="520" y="90" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="p1-ask" value='&lt;b&gt;분석 요청 입력&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;이미지 첨부 가능&lt;br&gt;Enter 전송&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="90" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="p1-agent" value='&lt;b&gt;Agent 가 처리&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;진행 상황이 실시간으로 보임&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;" vertex="1" parent="1"><mxGeometry x="1000" y="90" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="p1-hg" value="&lt;b&gt;확인 필요 카드 (Agent 가 물어볼 때만)&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;rounded=1;arcSize=3;dashed=1;fillColor=#fafafa;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="760" y="230" width="700" height="150" as="geometry"/></mxCell>
<mxCell id="p1-c1" value='&lt;b&gt;질문&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;답변을 입력&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;" vertex="1" parent="1"><mxGeometry x="790" y="280" width="190" height="76" as="geometry"/></mxCell>
<mxCell id="p1-c2" value='&lt;b&gt;계획 확인&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;승인하고 실행&lt;br&gt;또는 수정 요청&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;" vertex="1" parent="1"><mxGeometry x="1010" y="280" width="190" height="76" as="geometry"/></mxCell>
<mxCell id="p1-c3" value='&lt;b&gt;코드 실행 승인&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;실행 또는 거절&lt;br&gt;코드를 직접 고칠 수 있음&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;" vertex="1" parent="1"><mxGeometry x="1230" y="280" width="190" height="76" as="geometry"/></mxCell>
<mxCell id="p1-res" value='&lt;b&gt;결과 확인&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;답변, 표와 그림,&lt;br&gt;노트북 보기, JupyterLab에서 열기&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="220" height="76" as="geometry"/></mxCell>
<mxCell id="p1-ag" value="&lt;b&gt;결과를 본 뒤 필요에 따라&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;rounded=1;arcSize=3;dashed=1;fillColor=#fafafa;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="340" y="430" width="720" height="150" as="geometry"/></mxCell>
<mxCell id="p1-a1" value='&lt;b&gt;이어서 질문&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;같은 대화에서 계속&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="365" y="478" width="210" height="72" as="geometry"/></mxCell>
<mxCell id="p1-a2" value='&lt;b&gt;워크플로우로 저장&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;다음에 같은 분석을 추천받음&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="595" y="478" width="210" height="72" as="geometry"/></mxCell>
