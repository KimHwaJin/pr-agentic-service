<mxCell id="p1-aw09" value='&lt;b&gt;AW-09 gaia 연동 workflow&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;gaia_bridge (dtest.analyst)&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="90" width="200" height="50" as="geometry"/></mxCell>
