<mxCell id="p1-aw02" value='&lt;b&gt;AW-02 데이터 분석&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;담당자 analyst&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;rounded=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;" vertex="1" parent="1"><mxGeometry x="860" y="215" width="220" height="50" as="geometry"/></mxCell>
<mxCell id="p1-aw07" value='&lt;b&gt;AW-07 대화 요약&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;middleware, 3만 토큰 넘으면&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;rounded=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;" vertex="1" parent="1"><mxGeometry x="560" y="320" width="220" height="50" as="geometry"/></mxCell>
