<mxCell id="p1-t_gaia" value="&lt;b&gt;gaia 채팅 메시지&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;rounded=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="200" height="50" as="geometry"/></mxCell>
<mxCell id="p1-t_chat" value='&lt;b&gt;채팅 메시지&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;POST /sessions/{id}/runs&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;rounded=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="215" width="200" height="50" as="geometry"/></mxCell>
