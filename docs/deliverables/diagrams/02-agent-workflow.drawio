<mxCell id="p1-t_mem" value='&lt;b&gt;대화가 잠잠해짐&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;180초 조용 또는 5턴 누적&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;rounded=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="200" height="50" as="geometry"/></mxCell>
