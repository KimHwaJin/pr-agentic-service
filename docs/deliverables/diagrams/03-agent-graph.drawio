<diagram id="p6" name="메모리 추출">
<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="420" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="p6-title" value="&lt;b&gt;프로젝트 메모리 추출 흐름 (AW-05)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="900" height="30" as="geometry"/></mxCell>
<mxCell id="p6-m0" value='&lt;b&gt;턴 종료&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;RunScheduler가 프로젝트를&lt;br&gt;dirty로 표시, pending_turns 증가&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="p6-m1" value='&lt;b&gt;대기&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;대화가 180초 조용하거나&lt;br&gt;5턴이 쌓일 때까지&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="90" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="p6-m2" value='&lt;b&gt;작업 잡기&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;MemoryWorker가 lease 획득&lt;br&gt;(FOR UPDATE SKIP LOCKED)&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="90" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="p6-m3" value='&lt;b&gt;메시지 읽기&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;커서 뒤의 user, assistant&lt;br&gt;메시지 (최대 8,000 토큰)&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="1120" y="90" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="p6-m4" value='&lt;b&gt;LLM 1회 호출&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;prompts/memory_worker.md&lt;br&gt;주제별 줄 편집을 제안&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="p6-m5" value='&lt;b&gt;코드 검증&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;인용이 사용자 메시지에 있는지,&lt;br&gt;URL·경로·제목이 없는지, id 존재&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="240" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="p6-m6" value='&lt;b&gt;반영&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;store에 쓰고 memory_history 기록&lt;br&gt;커서 전진, memory_updated 이벤트&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="240" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="p6-en" value="사용자가 직접 말한 오래 갈 사실, 선호, 관심사, 일정만 남깁니다. 검증에 실패한 편집은 버리고 나머지는 반영합니다. 계속 실패하는 구간은 건너뜁니다." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="1400" height="20" as="geometry"/></mxCell>
