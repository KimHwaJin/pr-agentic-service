<diagram id="p2" name="담당자 전환">
<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="420" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="p2-title" value="&lt;b&gt;담당자(persona) 전환&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="900" height="30" as="geometry"/></mxCell>
<mxCell id="p2-st" value="&lt;b&gt;턴 시작&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;rounded=1;arcSize=40;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="110" height="44" as="geometry"/></mxCell>
<mxCell id="p2-main" value='&lt;b&gt;대화 담당 main&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;prompts/main.md&lt;br&gt;ask_user, read_knowledge,&lt;br&gt;save_memory, delete_memory,&lt;br&gt;start_analysis&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;rounded=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="150" width="260" height="104" as="geometry"/></mxCell>
<mxCell id="p2-an" value='&lt;b&gt;분석 담당 analyst&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;prompts/analyst.md&lt;br&gt;ask_user, read_knowledge, read_skill,&lt;br&gt;read_tool, search_tools, search_workflows,&lt;br&gt;propose_plans, revise_call, run_plan,&lt;br&gt;run_custom_code, write_report,&lt;br&gt;save_workflow, finish_analysis&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;rounded=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="120" width="290" height="164" as="geometry"/></mxCell>
<mxCell id="p2-en" value="&lt;b&gt;턴 끝&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;rounded=1;arcSize=40;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="110" height="44" as="geometry"/></mxCell>
<mxCell id="p2-sn" value="두 담당자는 같은 메시지 기록을 봅니다. 상대가 읽은 분석 skill, tool 설명, 워크플로우 검색 결과는 가려집니다." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="385" width="1000" height="20" as="geometry"/></mxCell>
