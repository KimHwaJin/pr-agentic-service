<mxfile host="app.diagrams.net" agent="pr-agentic-service docs" version="24.7.17">
<diagram id="p1" name="Agent Graph">
<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1010" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="p1-title" value="&lt;b&gt;채팅 Agent Graph 한 바퀴 (middleware 훅 순서)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="900" height="30" as="geometry"/></mxCell>
<mxCell id="p1-start" value='&lt;b&gt;턴 시작&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;사용자 메시지 추가, 또는 멈춘 지점에서 재개 (Command resume)&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;rounded=1;arcSize=40;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="470" y="70" width="460" height="44" as="geometry"/></mxCell>
<mxCell id="p1-ba" value='&lt;b&gt;before_agent&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Persona: 프로젝트 메모리 불러오기, nudges·notice 초기화&lt;br&gt;TurnModelCallLimit: 새 턴이면 호출 수 초기화&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="470" y="150" width="460" height="60" as="geometry"/></mxCell>
<mxCell id="p1-bm" value='&lt;b&gt;before_model&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;TurnModelCallLimit: 한 턴 모델 호출 40회 넘었는지 확인&lt;br&gt;Summarization: 3만 토큰(어림) 넘으면 앞부분 요약&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="470" y="250" width="460" height="60" as="geometry"/></mxCell>
<mxCell id="p1-wm" value='&lt;b&gt;wrap_model_call&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Persona: 담당자(active_agent)의 프롬프트 렌더&lt;br&gt;+ 프로젝트 지침 + 프로젝트 메모리&lt;br&gt;담당자의 도구만 남김, 다른 담당자가 읽은 자료는 가림&lt;br&gt;이미지 참조를 실제 이미지로 바꿈&lt;br&gt;ToolCallDedup: 응답 안의 중복 도구 호출 정리&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="470" y="350" width="460" height="110" as="geometry"/></mxCell>
<mxCell id="p1-model" value='&lt;b&gt;model 노드&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;LLM 게이트웨이 호출 (토큰은 50ms 묶음으로 SSE 전달)&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;rounded=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;" vertex="1" parent="1"><mxGeometry x="470" y="500" width="460" height="44" as="geometry"/></mxCell>
<mxCell id="p1-am" value='&lt;b&gt;after_model&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Persona: 분석 담당이 도구 없이 글만 냈는지 확인&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="470" y="584" width="460" height="44" as="geometry"/></mxCell>
<mxCell id="p1-q" value="&lt;b&gt;도구 호출이&lt;br&gt;있는가&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rhombus;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="620" y="668" width="160" height="90" as="geometry"/></mxCell>
<mxCell id="p1-aa" value='&lt;b&gt;after_agent&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Persona: active_agent를 main으로 되돌림&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="470" y="810" width="460" height="44" as="geometry"/></mxCell>
<mxCell id="p1-end" value='&lt;b&gt;턴 끝&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;마지막 AI 메시지가 답 (message_final)&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;rounded=1;arcSize=40;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="470" y="900" width="460" height="44" as="geometry"/></mxCell>
<mxCell id="p1-tools" value='&lt;b&gt;tools 노드&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;JsonArguments: 문자열로 온 JSON 인자 복구&lt;br&gt;ToolFailureLimit: 같은 오류 연속 3회면 실행 중단&lt;br&gt;도구 실행&lt;br&gt;ToolError: 예외를 오류 메시지로 모델에 전달&lt;br&gt;Compaction: finish_analysis 때 끝난 분석 결과 정리&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;rounded=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;" vertex="1" parent="1"><mxGeometry x="1010" y="500" width="340" height="130" as="geometry"/></mxCell>
<mxCell id="p1-pause" value='&lt;b&gt;그래프 멈춤&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;interrupt: 승인 요청, 질문, executor 대기&lt;br&gt;상태를 체크포인트에 저장, run은 waiting_*&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;rounded=1;arcSize=40;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1010" y="700" width="340" height="60" as="geometry"/></mxCell>
<mxCell id="p1-nudge" value='&lt;b&gt;분석 담당이 글만 냄&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;버리고 다시 시킴 (최대 2번)&lt;br&gt;그래도 멈추면 대화 담당이 넘겨받아&lt;br&gt;상황을 설명&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="668" width="330" height="90" as="geometry"/></mxCell>
<mxCell id="p1-gn" value="파랑: middleware 훅 / 보라: 그래프 노드 / 담당자(main, analyst)는 별도 그래프가 아니라 상태값 active_agent입니다." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="970" width="1200" height="20" as="geometry"/></mxCell>
