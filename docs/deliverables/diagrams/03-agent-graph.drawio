<mxCell id="p5-ev" value='&lt;b&gt;배치 실행 성공 이벤트&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;executor가 Redis 스트림에 씀&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="200" height="56" as="geometry"/></mxCell>
