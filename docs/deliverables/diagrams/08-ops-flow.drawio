<mxfile host="app.diagrams.net" agent="pr-agentic-service docs" version="24.7.17">
<diagram id="p1" name="장애 대응 순서">
<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="700" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="p1-title" value="&lt;b&gt;장애 대응: 먼저 보는 순서&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="900" height="30" as="geometry"/></mxCell>
<mxCell id="p1-start" value="&lt;b&gt;이상 신고 또는 알림&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;rounded=1;arcSize=40;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="220" height="50" as="geometry"/></mxCell>
<mxCell id="p1-s1" value='&lt;b&gt;1. 인스턴스 상태&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;떠 있는가, 재시작을 반복하는가&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="p1-a1" value='&lt;b&gt;기동 로그 확인&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;ValueError, dtest_startup_failed&lt;br&gt;설정 검사, 마이그레이션, DB·Redis 접속&lt;br&gt;(운영자 메뉴얼 2.4, 4.4절)&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;align=center;" vertex="1" parent="1"><mxGeometry x="420" y="166" width="330" height="78" as="geometry"/></mxCell>
<mxCell id="p1-s2" value='&lt;b&gt;2. GET /api/v1/healthz&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;status 가 ok 인가&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="p1-a2" value='&lt;b&gt;죽은 루프 확인&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;응답의 stopped 에 루프 이름&lt;br&gt;실행 환경이 인스턴스를 재시작함&lt;br&gt;반복되면 직전 예외 로그 (9.3절)&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;align=center;" vertex="1" parent="1"><mxGeometry x="420" y="266" width="330" height="78" as="geometry"/></mxCell>
<mxCell id="p1-s3" value='&lt;b&gt;3. 앱 로그&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;오류 ID, X-Request-ID,&lt;br&gt;로그 키워드로 검색&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="p1-a3" value='&lt;b&gt;증상별 대응표로 이동&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;로그 키워드 사전 (6.11절)&lt;br&gt;증상별 대응표 (6.3절)&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="420" y="366" width="330" height="78" as="geometry"/></mxCell>
<mxCell id="p1-s4" value='&lt;b&gt;4. DB&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;run 상태 분포, 연결 수&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="p1-a4" value='&lt;b&gt;run, DB 대응&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;queued 적체, failed 증가 (6.5절)&lt;br&gt;연결 한도 (6.8절), 자주 쓰는 SQL (6.9절)&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="420" y="466" width="330" height="78" as="geometry"/></mxCell>
<mxCell id="p1-s5" value='&lt;b&gt;5. 연결된 서비스&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;executor, pr-batch,&lt;br&gt;LLM 게이트웨이, Redis&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="p1-a5" value='&lt;b&gt;상대 서비스 확인&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;502 는 upstream_unreachable path 로 구분&lt;br&gt;분석이 안 끝나면 executor 대기 (6.6절)&lt;br&gt;시스템 화면의 런타임, 이벤트 스트림 (10장)&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;align=center;" vertex="1" parent="1"><mxGeometry x="420" y="566" width="330" height="78" as="geometry"/></mxCell>
<mxCell id="p1-g" value="&lt;b&gt;화면에서 바로 할 수 있는 조치 (시스템 탭, 관리자)&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;rounded=1;arcSize=3;dashed=1;fillColor=#fafafa;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="830" y="80" width="610" height="560" as="geometry"/></mxCell>
<mxCell id="p1-t1" value='&lt;b&gt;런타임&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;런타임별 CPU, 메모리, 실행 슬롯&lt;br&gt;점검, 비우기, 활성화, 사용 중지&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;align=center;" vertex="1" parent="1"><mxGeometry x="860" y="130" width="550" height="76" as="geometry"/></mxCell>
<mxCell id="p1-t2" value='&lt;b&gt;런타임 커널&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;커널별 메모리와 그 커널을 쓰는 실행&lt;br&gt;실행 취소, 남겨진 커널 삭제&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;align=center;" vertex="1" parent="1"><mxGeometry x="860" y="230" width="550" height="76" as="geometry"/></mxCell>
<mxCell id="p1-t3" value='&lt;b&gt;점검&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;새 실행 접수 중지와 재개&lt;br&gt;진행 중 실행 멈추기&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;align=center;" vertex="1" parent="1"><mxGeometry x="860" y="330" width="550" height="76" as="geometry"/></mxCell>
<mxCell id="p1-t4" value='&lt;b&gt;이벤트 스트림&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;tenant별 Redis 스트림 항목 수,&lt;br&gt;consumer group 의 lag, pending&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;align=center;" vertex="1" parent="1"><mxGeometry x="860" y="430" width="550" height="76" as="geometry"/></mxCell>
<mxCell id="p1-t5" value='&lt;b&gt;사용자, API 키&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;사용자 비활성화, 역할 변경&lt;br&gt;키 발급, 재발급, 폐기&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;align=center;" vertex="1" parent="1"><mxGeometry x="860" y="530" width="550" height="76" as="geometry"/></mxCell>
<mxCell id="p1-n" value="절 번호는 운영자 메뉴얼의 절입니다. 이상 신호의 기준값은 7.2절에 있습니다." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="760" height="20" as="geometry"/></mxCell>
